{
  "name": "salary-manager-local",
  "version": "6.0.0",
  "description": "Offline payroll analysis application",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "package": "pkg . --targets node16-win-x64 --output dist/SalaryManager.exe",
    "prepare:web": "node scripts/prepare-web.js",
    "android:init": "npm run prepare:web && cap add android",
    "android:sync": "npm run prepare:web && cap sync android",
    "android:debug": "npm run android:sync && cap open android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "android:apk:release": "npm run android:sync && cd android && gradlew.bat assembleRelease"
  },
  "keywords": [],
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "echarts": "^6.0.0",
    "express": "^4.19.2",
    "feather-icons": "^4.29.2",
    "tesseract.js": "^7.0.0",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "pkg": "^5.8.1"
  },
  "capacitor": {
    "appId": "com.wwhooo.Skye.RayRoll",
    "appName": "薪澈",
    "webDir": "public"
  },
  "bin": "server.prod.js",
  "pkg": {
    "assets": ["public/**/*"]
  }
}
